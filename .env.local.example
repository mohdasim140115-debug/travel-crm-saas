# Copy to .env.local and fill values (never commit real secrets).

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/travel-crm

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-other-long-random

# -----------------------------------------------------------------------------
# OAuth (Google Sign-In via ID token POST /api/auth/google)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Google Places API (Hotel search in Owner Settings → Hotel Management)
# Enable the "Places API (New)" in Google Cloud and paste the key here.
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical production domain used for SEO metadata (canonical URLs, sitemap,
# robots.txt, Open Graph/Twitter). Falls back to NEXT_PUBLIC_APP_URL, then
# localhost, if unset — but set this explicitly in production.
NEXT_PUBLIC_SITE_URL=https://www.travdx.com

# -----------------------------------------------------------------------------
# Meta Lead Ads webhook (POST /api/webhooks/meta/leads)
# -----------------------------------------------------------------------------
META_WEBHOOK_VERIFY_TOKEN=travel_crm_verify
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Meta Conversions API — CRM → Meta status feedback for Meta-origin leads
# (server-side only; never exposed to the browser). Reuses the Meta lead id
# already stored on ingest (Lead.externalId) — see lib/metaCapi/.
#
# This app is multi-tenant — every agency has its own Meta dataset, so the
# Dataset ID + access token are NOT env vars (a single shared token here would
# leak into every team's conversion events). Each team saves its own from
# Settings → Meta Lead Ads → "Conversions API" card, encrypted in the DB the
# same way as the existing Page Access Token. Only these two shared, non-secret
# defaults come from env:
# -----------------------------------------------------------------------------
META_API_VERSION=v21.0
# One of: phone_call | chat | physical_store | system_generated | other
META_CAPI_ACTION_SOURCE=system_generated

# -----------------------------------------------------------------------------
# Google Ads leads — Lead Form webhook (POST /api/webhooks/google/leads) +
# Landing Page/Website (POST /api/public/leads, same key as Meta/Zapier above)
# + OAuth connect for the live campaign picker in Dashboard → Team & Weights.
# A dedicated OAuth client, separate from GOOGLE_CLIENT_ID above (Google
# sign-in) — different scope/consent screen, so one can never affect the other.
# -----------------------------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_TOKEN_SECRET=
GOOGLE_ADS_API_VERSION=v17

# -----------------------------------------------------------------------------
# SMTP (email OTP flows)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# WhatsApp providers (stub until wired — AiSensy / Meta Cloud API)
# -----------------------------------------------------------------------------
WHATSAPP_API_KEY=
WHATSAPP_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Payments (optional Razorpay)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
# Redis powers Bull queues + enhanced rate limiting
REDIS_URL=

# -----------------------------------------------------------------------------
# Cron (follow-up reminders POST /api/cron/reminders)
# -----------------------------------------------------------------------------
CRON_SECRET=another-long-secret

# -----------------------------------------------------------------------------
# AWS S3 (presigned uploads stub in /api/upload/presign — add SDK to enable)
# -----------------------------------------------------------------------------
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NODE_ENV=development
